main visitor:

ast.Program type:
  {for p in .Packages-}
  import "${p.Path}"
  {end-}

  {if .Packages}
  {end-}

  {for fd in .Main.FuncDefs-}
  @{fd}
  {end-}

  {if .Main.FuncDefs}
  {end-}

  {for st in .Root.Statements-}
  @{st}
  {end-}

ast.FuncStatement type:
  @{.Call}{if .Catch} @{.Catch}{end}

ast.Catch type:
  catch ${.Error.Name} {
    @{.Block}
  }

ast.Fail type:
  fail(@{.Message})

ast.Func type:
  {if .Try}try {end}${.Name}(@{.Parameters})

ast.Cmd type:
  {if .Try}try {end}cmd({for i, a, first in .Args}{if !first}, {end}@{a.Value}{if a.Spread}...{end}{end}
  {-if .Stdout}, stdout: @{.Stdout}{end}
  {-if .Stderr}, stderr: @{.Stderr}{end}
  {-if .Exit.Print != ""}, exit: ${.Exit.Print}{end}
  {-if .Stdin}, stdin: @{.Stdin}{end}
  {-if .Dir}, dir: @{.Dir}{end}
  {-for i, e in .Env}, $${e.Name}: @{e.Value}{end})
  {-if .Body} {
    @{.Body}
  }{end}

ast.Target type:
  ${.Print}{if .Path}(@{.Path}){end}

ast.Input type:
  {if .IsFile}file(@{.Value}){else}@{.Value}{end}

ast.Method type:
  {if .Func.Try}try {end}${.Namespace}.${.Func.Name}(@{.Func.Parameters})

ast.FuncDef type:
  func ${.Name}(@{.Params}){if .Returns} @{.Returns}{if .CanFail}, error{end}{else}{if .CanFail} error{end}{end} {
    @{.Body}
  }

ast.ReturnStatement type:
  return{if .Expressions} @{.Expressions}{end}

[]ast.Param type:
  {for i, p, first in .}{if !first}, {end}${p.Name} ${p.Type.Print}{end}

[]common.Type type:
  {for i, t, first in .}{if !first}, {end}${t.Print}{end}

ast.Block type:
  {for i, st, first in .Statements-}
  {if !first}
  {end-}
  @{st}
  {-end}

ast.Assignment type:
  {if .Global}global {end}{for i, n, first in .Targets}{if !first}, {end}${n.Name}{if n.Element}[@{n.Element.Position}]{end}{end}
  ${-" = "-}
  @{.Expressions}{if .Catch} @{.Catch}{end}

ast.For type:
  for {if .Initial}@{.Initial}; {end}{if .Condition}@{.Condition}{end}{if .Each}; @{.Each}{end}{if .Condition} {end}{
    @{.Body}
  }

ast.ForIn type:
  for ${.Value.Name}{if .Index}, ${.Index.Name}{end} in {if .From}@{.From} until {end}@{.Over} {
    @{.Body}
  }

ast.Break type:
  break

ast.Continue type:
  continue

ast.If type:
  if @{.Condition} {
    @{.If}
  }{if .Else} else {
    @{.Else}
  }{end}

ast.Array type:
  [@{.Values}]

ast.Index type:
  (@{.Value})[@{.Position}]

ast.TargetValue type:
  ${.Target.Name}[@{.Target.Element.Position}]

ast.Slice type:
  (@{.Value})[{if .From}@{.From}{end}:{if .To}@{.To}{end}]

[]ast.Expression type:
  {for i, x, first in .}{if !first}, {end}@{x}{end}

ast.String type:
  "${.Value}"

ast.Number type:
  ${.Value}

ast.Bool type:
  ${.Value}

ast.Var type:
  {if .Namespace}${.Namespace}.{end}${.Name}

ast.EnvVar type:
  $${.Name}

ast.Add type:
  @{.A} + @{.B}

ast.Sub type:
  @{.A} - @{.B}

ast.Minus type:
  -@{.Expression}

ast.Not type:
  !@{.Expression}

ast.Mul type:
  @{.A} * @{.B}

ast.Div type:
  @{.A} / @{.B}

ast.Mod type:
  @{.A} % @{.B}

ast.And type:
  @{.A} && @{.B}

ast.Or type:
  @{.A} || @{.B}

ast.LessThan type:
  @{.A} < @{.B}

ast.LessThanEqual type:
  @{.A} <= @{.B}

ast.GreaterThan type:
  @{.A} > @{.B}

ast.GreaterThanEqual type:
  @{.A} >= @{.B}

ast.Equal type:
  @{.A} == @{.B}

ast.NotEqual type:
  @{.A} != @{.B}

ast.Ternary type:
  @{.Condition} ? @{.True} : @{.False}

ast.Group type:
  (@{.Expression})