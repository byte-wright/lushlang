main visitor:

bcode.Program type:
  {for i, fd, first in .Funcs-}
    func ${fd.FullName}(){if fd.CanFail} error{end} {
    @{fd.Body}
  }
  {end-}

  @{.Main}

bcode.Block type:
  {indent 2-}
  {for i, cmd, first in .Commands-}
    @{cmd}
  {end-}
  {end}

bcode.Assignment type:
  ${.Var.Name} = @{.Value}

bcode.VarValue type:
  ${.Name}:${.Type.Print}

bcode.Index type:
  @{.Value}[@{.Position}]

bcode.Slice type:
  @{.Value}[{if .From}@{.From}{end}:{if .To}@{.To}{end}]

bcode.Len type:
  len(@{.Parameter})

bcode.EnvVarValue type:
  $${.Name}

bcode.ArgsValue type:
  args()

bcode.Func type:
  {if .Return}@{.Return} = {end-}
  {if .Try}try {end}${.FullName}(@{.Parameters})

bcode.Catch type:
  @{.Call} catch {
    @{.Block}
  } then {
    @{.Then}
  }

bcode.Fail type:
  fail @{.Message}

bcode.ErrorValue type:
  error

[]bcode.VarValue type:
  {for i, a, first in .}{if !first}, {end}@{a}{end}

[]bcode.Value type:
  {for i, a, first in .}{if !first}, {end}@{a}{end}

bcode.Params type:
  params @{.Vars}

bcode.Return type:
  return @{.Values}

bcode.If type:
  if @{.Condition} {
    @{.Block}
  }{if .Else} else {
    @{.Else}
  }{end}

bcode.While type:
  while {if .Condition}{
    @{.Check}
  } @{.Condition} {end}{
    @{.Block}
  }

bcode.ForEach type:
  for @{.Element} in @{.Array} {
    @{.Block}
  }

bcode.Break type:
  break

bcode.Continue type:
  continue

bcode.Code type:
  {indent -2 -}
  ${.Code}
  {-end}

// use visitor for var name
bcode.Append type:
  ${.Target.Name} = append(@{.Array}, @{.Elements})

bcode.StringValue type:
  "${.Value}"

bcode.NumberValue type:
  ${.Value}

bcode.BoolValue type:
  ${.Value}

bcode.ArrayValue type:
  [@{.Values}]

[]bcode.Atom type:
  {for i, a, first in .}{if !first}, {end}@{a}{end}

bcode.Add type:
  @{.Left} + @{.Right}

bcode.Sub type:
  @{.Left} - @{.Right}

bcode.Minus type:
  -@{.Expression}

bcode.Mul type:
  @{.Left} * @{.Right}

bcode.Div type:
  @{.Left} / @{.Right}

bcode.Mod type:
  @{.Left} % @{.Right}

bcode.Not type:
  !@{.Expression}

bcode.GreaterThan type:
  @{.Left} > @{.Right}

bcode.GreaterThanEqual type:
  @{.Left} >= @{.Right}

bcode.LessThan type:
  @{.Left} < @{.Right}

bcode.LessThanEqual type:
  @{.Left} <= @{.Right}

bcode.Equal type:
  @{.Left} == @{.Right}

bcode.NotEqual type:
  @{.Left} != @{.Right}

bcode.Cmd type:
  {for i, p, first in .Procs-}
    @{p}
  {end-}
  {if .Body-}
    read ${.Pipe.Name} {
    @{.Body}
  }
  {end-}

bcode.Proc type:
  ${.Code.Name}{if .Stopped}, ${.Stopped.Name}{end} = proc(@{.Name}{for i, a in .Args}, @{a}{end})
  {-if .Stdin} <@{.Stdin}{end}
  {-if .Stdout} >@{.Stdout}{end}
  {-if .Stderr} 2>@{.Stderr}{end}
  {-if .Dir} dir @{.Dir}{end}
  {-for i, e in .Env} $${e.Name}=@{e.Value}{end}

bcode.ProcArg type:
  {if .Source}pipe(${.Source.Code.Name}){else}@{.Value}{if .Spread}...{end}{end}

bcode.ProcInput type:
  {if .Source}pipe(${.Source.Code.Name}){else}@{.Value}{end}

bcode.ProcOutput type:
  ${.Name}{if .Path}(@{.Path}){end}{if .Var} @{.Var}{end}{if .Text} @{.Text}{end}

bcode.ReadLines type:
  for @{.Line} in ${.Pipe.Name} {
    @{.Block}
  }
