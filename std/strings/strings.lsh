
func hasPrefix(s string, prefix string) bool ```
  if [[ "$s" == "$prefix"* ]]; then
    L_ret0=true
  else
    L_ret0=false
  fi
```

func hasSuffix(s string, suffix string) bool ```
  if [[ "$s" == *"$suffix" ]]; then
    L_ret0=true
  else
    L_ret0=false
  fi
```

func trimPrefix(s string, prefix string) string ```
  L_ret0="${s#"$prefix"}"
```

func trimSuffix(s string, suffix string) string ```
  L_ret0="${s%"$suffix"}"
```

func indexOf(s string, sub string) int ```
  if [[ "$s" == *"$sub"* ]]; then
    local before="${s%%"$sub"*}"
    L_ret0="${#before}"
  else
    L_ret0=-1
  fi
```

func cut(s string, sep string) string, string, bool ```
  if [[ "$s" == *"$sep"* ]]; then
    L_ret0="${s%%"$sep"*}"
    L_ret1="${s#*"$sep"}"
    L_ret2=true
  else
    L_ret0="$s"
    L_ret1=""
    L_ret2=false
  fi
```

func join(strs []string, sep string) string ```
  local i=2
  local v=""
  local di=$(($1+2))
  for (( i=2;i<$di;i++ )); do
    if [ $i -eq 2 ]; then
      v="${!i}"
    else
      v="$v${!di}${!i}"
    fi
  done
  L_ret0="${v}"
```