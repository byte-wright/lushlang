// like the basename command: "a/b/" gives "b", "/" gives "/" and "" gives "."
func base(path string) string ```
  if [ -z "$path" ]; then
    L_ret0=.
    return
  fi
  local LC_ALL=C
  path="${path%"${path##*[!/]}"}"
  L_ret0="${path##*/}"
  L_ret0="${L_ret0:-/}"
```

// like the dirname command: "a/b/" gives "a", "/a" gives "/" and "a" gives "."
func dir(path string) string ```
  if [ -z "$path" ]; then
    L_ret0=.
    return
  fi
  local LC_ALL=C
  path="${path%"${path##*[!/]}"}"
  case "$path" in
    "")
      L_ret0=/
      ;;
    */*)
      path="${path%/*}"
      path="${path%"${path##*[!/]}"}"
      L_ret0="${path:-/}"
      ;;
    *)
      L_ret0=.
      ;;
  esac
```
