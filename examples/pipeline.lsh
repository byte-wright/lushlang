import "strings"

project = $CI_PROJECT_NAME

isSuccess = $CI_JOB_STATUS == "success"
isFailure = $CI_JOB_STATUS == "failure"

isMain = $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

pmTest = !isMain && strings.hasPrefix($CI_COMMIT_BRANCH, "projectmonitor/")
pmMerge = isMain && strings.hasPrefix($CI_COMMIT_TITLE, "Mergerequest from projectmonitor/")

if pmTest {
  println("we run a merge request pipeline")
  operation = strings.trimPrefix($CI_COMMIT_BRANCH, "projectmonitor/")
  operation = operation[0:strings.indexOf(operation, "-")]

  if operation != "" {
    msg = isSuccess ? "ready" : "error"
    println("set status", msg)
  }
}

if pmMerge {
  println("we merged a pipeline into main")

  operation = strings.trimPrefix($CI_COMMIT_TITLE, "Mergerequest from projectmonitor/")
  operation = operation[0:strings.indexOf(operation, "-")]

  if operation != "" {
    msg = isSuccess ? "ok" : "error"
    println("set status", msg)
  }
}
